<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <LSLibDir Condition="'$(LSLibDir)' == ''">$(UserProfile)/.cache/nudegate/gr2-tools/Divine-1.20.4</LSLibDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LSLib"><HintPath>$(LSLibDir)/LSLib.dll</HintPath></Reference>
    <Reference Include="OpenTK.Mathematics"><HintPath>$(LSLibDir)/OpenTK.Mathematics.dll</HintPath></Reference>
    <Content Include="$(LSLibDir)/*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Update="toolchain-pins.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
